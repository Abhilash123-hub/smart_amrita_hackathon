# Dockerfile for TraceAI Celery / Async Pipeline Workers
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    libmagic1 \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml /app/

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir celery redis pydantic pydantic-settings cryptography Pillow imagehash numpy torch torchvision sentence-transformers opencv-python pytest pytest-asyncio httpx

COPY . /app/
RUN pip install --no-cache-dir -e .

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
    CMD python -m traceai.cli doctor || exit 1

CMD ["python", "-m", "traceai.cli", "doctor"]
