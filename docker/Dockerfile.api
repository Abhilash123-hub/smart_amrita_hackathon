# Dockerfile for TraceAI FastAPI Ingestion Gateway API
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    libmagic1 \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency specifications
COPY pyproject.toml /app/

# Install python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir fastapi uvicorn pydantic pydantic-settings cryptography Pillow imagehash numpy redis asyncpg psycopg2-binary pytest ruff httpx

# Copy source
COPY . /app/
RUN pip install --no-cache-dir -e .

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/info || exit 1

CMD ["uvicorn", "traceai.api.server:app", "--host", "0.0.0.0", "--port", "8000"]
