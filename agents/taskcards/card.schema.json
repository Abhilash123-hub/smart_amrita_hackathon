{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TraceAITaskCard",
  "type": "object",
  "required": [
    "id",
    "phase",
    "title",
    "objective",
    "agent_steps",
    "files",
    "acceptance_criteria",
    "verification",
    "status"
  ],
  "properties": {
    "id": { "type": "string" },
    "phase": { "type": "string" },
    "title": { "type": "string" },
    "objective": { "type": "string" },
    "agent_steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verification": { "type": "string" },
    "depends_on": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "blocked", "merged"]
    }
  }
}
