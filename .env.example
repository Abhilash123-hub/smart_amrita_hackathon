# TraceAI Environment Configuration Template
# Copy to .env for local overrides (never commit secrets to version control)

# Server Configuration
TRACEAI_HOST=127.0.0.1
TRACEAI_PORT=8000
TRACEAI_DEBUG=false

# Cryptographic Keys (Auto-generated in memory if not supplied)
# TRACEAI_PRIVATE_KEY_PATH=./keys/traceai_rsa.pem
# TRACEAI_PUBLIC_KEY_PATH=./keys/traceai_rsa_pub.pem
RSA_KEY_BITS=2048

# Multimodal Similarity Thresholds
TEXT_CROSS_ENCODER_THRESHOLD=0.85
IMAGE_PHASH_HAMMING_THRESHOLD=5
IMAGE_CLIP_COSINE_THRESHOLD=0.90
AUDIO_COSINE_THRESHOLD=0.88
CODE_STRUCTURAL_THRESHOLD=0.85

# Dataset Paths
DATA_DIR=./data
MOCK_INDEX_DIR=./mock_data/copyright_index
